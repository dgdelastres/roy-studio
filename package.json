{
  "name": "roy-studio",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Aplicación para formulación, análisis de grafos ROY (MPM), programación Gantt y gestión de proyectos industriales",
  "author": "Daniel García de Lastres <d.gdelastres@gmail.com>",
  "homepage": "https://github.com/dgdelastres/roy-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/dgdelastres/roy-studio.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "electron:dev": "concurrently \"vite\" \"cross-env WAIT_FOR_DEV=1 electron .\"",
    "electron:build": "tsc && vite build && electron-builder",
    "pack:fast": "powershell -ExecutionPolicy Bypass -File scripts/pack-fast.ps1",
    "pack:silent": "powershell -ExecutionPolicy Bypass -File scripts/build-portable-silent.ps1"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@xyflow/react": "^12.3.5",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/dagre": "^0.7.52",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "build": {
    "appId": "com.dgdelastres.roystudio",
    "productName": "ROY Studio",
    "copyright": "Copyright © 2026 Daniel García de Lastres",
    "directories": {
      "output": "dist-win"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "legalTrademarks": "ROY Studio",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ROY Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "ROY Studio",
      "artifactName": "ROY-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ROY-Studio-Portable-${version}.${ext}"
    }
  }
}
